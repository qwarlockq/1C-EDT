#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СкоростьИгры = 0.05;
	ШаговЗаКадр  = 1;
	ШиринаПоля   = 50;
	ВысотаПоля   = 50;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПолеВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Если ЭтаФорма.Значения[Область.Верх - 1]["К" + Область.Право] Тогда
		Область.ЦветФона = Новый Цвет;
	Иначе
		Область.ЦветФона = WebЦвета.Черный;
	КонецЕсли;
	
	УстановитьТочку(Область.Верх, Область.Право);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Старт(Команда)
	
	Если ПолеСформировано Тогда
		
		Поколение = 0;
		Стоп      = Ложь;
		Интервал  = Макс(СкоростьИгры, 0.001);
		
		ПодключитьОбработчикОжидания("Жизнь", Интервал, Истина);
		
	Иначе
		Сообщить(НСтр("ru = 'Поле не сформировано. Необходимо нажать на кнопку ""Сформировать поле"".'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Стоп(Команда)
	
	Стоп = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПоле(Команда)
	
	ВывестиПоле();
	ЗаполнитьТЗПоля();
	
КонецПроцедуры

&НаКлиенте
Процедура НарисоватьГлайдер(Команда)
	
	НарисоватьФигуру("Глайдер");
	
КонецПроцедуры

&НаКлиенте
Процедура НарисоватьМигалку(Команда)
	
	НарисоватьФигуру("Мигалка");
	
КонецПроцедуры

&НаКлиенте
Процедура НарисоватьБлок(Команда)
	
	НарисоватьФигуру("Блок");
	
КонецПроцедуры

&НаКлиенте
Процедура НарисоватьЛКК(Команда)
	
	НарисоватьФигуру("ЛКК");
	
КонецПроцедуры

&НаКлиенте
Процедура НарисоватьПульсар(Команда)
	
	НарисоватьФигуру("Пульсар");
	
КонецПроцедуры

&НаКлиенте
Процедура НарисоватьРужьеГоспера(Команда)
	
	НарисоватьФигуру("Ружье Госпера");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Жизнь()
	
	Если Стоп Тогда
		Возврат;
	КонецЕсли;
	
	Ширина     = ШиринаПоля;
	Высота     = ВысотаПоля;
	ДанныеПоля = ЭтаФорма.Значения;
	
	// Матрица для накопления изменений отрисовки за N шагов
	ИзмененияОтрисовки = Новый Массив(Высота);
	Для Стр = 0 По Высота - 1 Цикл
		ИзмененияОтрисовки[Стр] = Новый Массив(Ширина);
	КонецЦикла;
	
	ТекущийШаг = 0;
	Шагов      = Макс(ШаговЗаКадр, 1);
	
	Пока ТекущийШаг < Шагов Цикл
		
		Состояние = Новый Массив(Высота);
		
		Для Стр = 0 По Высота - 1 Цикл
			
			СтрокаДанных    = ДанныеПоля[Стр];
			СтрокаСостояния = Новый Массив(Ширина);
			
			Для Кол = 1 По Ширина Цикл
				СтрокаСостояния[Кол - 1] = СтрокаДанных["К" + Кол];
			КонецЦикла;
			
			Состояние[Стр] = СтрокаСостояния;
			
		КонецЦикла;
		
		ИзмененияВПамяти = Новый Массив;
		
		Для Стр = 0 По Высота - 1 Цикл
			Для Кол = 0 По Ширина - 1 Цикл
				
				СуммаЖивых = 0;
				
				Если Стр > 0 Тогда
					СуммаЖивых = СуммаЖивых
						+ ?(Кол > 0 И Состояние[Стр - 1][Кол - 1], 1, 0)
						+ ?(Состояние[Стр - 1][Кол], 1, 0)
						+ ?(Кол < Ширина - 1 И Состояние[Стр - 1][Кол + 1], 1, 0);
				КонецЕсли;
				
				СуммаЖивых = СуммаЖивых
					+ ?(Кол > 0 И Состояние[Стр][Кол - 1], 1, 0)
					+ ?(Кол < Ширина - 1 И Состояние[Стр][Кол + 1], 1, 0);
				
				Если Стр < Высота - 1 Тогда
					СуммаЖивых = СуммаЖивых
						+ ?(Кол > 0 И Состояние[Стр + 1][Кол - 1], 1, 0)
						+ ?(Состояние[Стр + 1][Кол], 1, 0)
						+ ?(Кол < Ширина - 1 И Состояние[Стр + 1][Кол + 1], 1, 0);
				КонецЕсли;
				
				КлеткаЖива = Состояние[Стр][Кол];
				
				Если КлеткаЖива Тогда
					
					Если СуммаЖивых < 2 Или СуммаЖивых > 3 Тогда
						ИзмененияВПамяти.Добавить(Новый Структура("Стр, Кол, Значение", Стр, Кол, Ложь));
					КонецЕсли;
					
				Иначе
					
					Если СуммаЖивых = 3 Тогда
						ИзмененияВПамяти.Добавить(Новый Структура("Стр, Кол, Значение", Стр, Кол, Истина));
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
		Для Каждого Изменение Из ИзмененияВПамяти Цикл
			ДанныеПоля[Изменение.Стр]["К" + (Изменение.Кол + 1)] = Изменение.Значение;
			ИзмененияОтрисовки[Изменение.Стр][Изменение.Кол] = Изменение.Значение;
		КонецЦикла;
		
		Поколение  = Поколение + 1;
		ТекущийШаг = ТекущийШаг + 1;
		
	КонецЦикла;
	
	// Выполняем отрисовку один раз за кадр
	Для Стр = 0 По Высота - 1 Цикл
		Для Кол = 0 По Ширина - 1 Цикл
			
			ЗначениеОтрисовки = ИзмененияОтрисовки[Стр][Кол];
			
			Если ЗначениеОтрисовки <> Неопределено Тогда
				Поле.Область(Стр + 1, Кол + 1, Стр + 1, Кол + 1).ЦветФона = ?(ЗначениеОтрисовки, WebЦвета.Черный, Новый Цвет);
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Интервал = Макс(СкоростьИгры, 0.001);
	ПодключитьОбработчикОжидания("Жизнь", Интервал, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура НарисоватьФигуру(ИмяФигуры)
	
	Если Не ПолеСформировано Тогда
		Сообщить(НСтр("ru = 'Поле не сформировано. Сначала сформируйте поле.'"));
		Возврат;
	КонецЕсли;
	
	ТекущаяОбласть = Элементы.Поле.ТекущаяОбласть;
	
	Если ТекущаяОбласть = Неопределено Тогда
		Сообщить(НСтр("ru = 'Не выделена ячейка для размещения фигуры.'"));
		Возврат;
	КонецЕсли;
	
	Стр = ТекущаяОбласть.Верх;
	Кол = ТекущаяОбласть.Лево; 
	
	МассивТочек = Новый Массив;
	МакетФигуры = "";
	
	Если ИмяФигуры = "Глайдер" Тогда
		МакетФигуры = 
			"010
			|001
			|111";
	ИначеЕсли ИмяФигуры = "Мигалка" Тогда
		МакетФигуры = "111";
	ИначеЕсли ИмяФигуры = "Блок" Тогда
		МакетФигуры = 
			"11
			|11";
	ИначеЕсли ИмяФигуры = "ЛКК" Тогда
		МакетФигуры = 
			"01111
			|10001
			|00001
			|10010";
	ИначеЕсли ИмяФигуры = "Пульсар" Тогда
		МакетФигуры = 
			"0011100011100
			|0000000000000
			|1000010100001
			|1000010100001
			|1000010100001
			|0011100011100
			|0000000000000
			|0011100011100
			|1000010100001
			|1000010100001
			|1000010100001
			|0000000000000
			|0011100011100";
	ИначеЕсли ИмяФигуры = "Ружье Госпера" Тогда
		МакетФигуры = 
			"000000000000000000000000100000000000
			|000000000000000000000010100000000000
			|000000000000110000001100000000000011
			|000000000001000100001100000000000011
			|110000000010000010001100000000000000
			|110000000010001011000010100000000000
			|000000000010000010000000100000000000
			|000000000001000100000000000000000000
			|000000000000110000000000000000000000";
	КонецЕсли;
	
	ДобавитьПоМакету(МассивТочек, МакетФигуры, Стр, Кол);
	ОтрисоватьТочкиНаСервере(МассивТочек);
	
	Для Каждого Точка Из МассивТочек Цикл
		Если Точка.С <= ВысотаПоля И Точка.К <= ШиринаПоля И Точка.С > 0 И Точка.К > 0 Тогда
			Поле.Область(Точка.С, Точка.К, Точка.С, Точка.К).ЦветФона = WebЦвета.Черный;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоМакету(МассивТочек, Знач ТекстМакета, Знач НачальнаяСтрока, Знач НачальнаяКолонка)
	
	МассивСтрок = СтрРазделить(ТекстМакета, Символы.ПС);
	
	Для ИндСтроки = 0 По МассивСтрок.ВГраница() Цикл
		
		ТекСтрока = СокрЛП(МассивСтрок[ИндСтроки]);
		
		Если ПустаяСтрока(ТекСтрока) Тогда
			Продолжить;
		КонецЕсли;
		
		Для ИндКолонки = 1 По СтрДлина(ТекСтрока) Цикл
			
			Символ = Сред(ТекСтрока, ИндКолонки, 1);
			
			Если Символ = "1" Тогда
				МассивТочек.Добавить(Новый Структура("С, К", НачальнаяСтрока + ИндСтроки, НачальнаяКолонка + ИндКолонки - 1));
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОтрисоватьТочкиНаСервере(МассивТочек)
	
	ТЗПоля = РеквизитФормыВЗначение("Значения");
	
	Для Каждого Точка Из МассивТочек Цикл
		Если Точка.С <= ВысотаПоля И Точка.К <= ШиринаПоля И Точка.С > 0 И Точка.К > 0 Тогда
			ТЗПоля[Точка.С - 1]["К" + Точка.К] = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТЗПоля, "Значения");
	
КонецПроцедуры

&НаСервере
Процедура ВывестиПоле()
	
	Поле.Очистить();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Макет           = ОбработкаОбъект.ПолучитьМакет("Поле");
	ОбластьКолонка  = Макет.ПолучитьОбласть("Колонка");
	
	Для Сч = 1 По ВысотаПоля Цикл
		Поле.Вывести(ОбластьКолонка);
	КонецЦикла;
	
	ОбластьПрисоединения = Поле.ПолучитьОбласть(1, 1, ВысотаПоля, 1);
	
	Для Сч = 1 По ШиринаПоля - 1 Цикл
		Поле.Присоединить(ОбластьПрисоединения);
	КонецЦикла;
	
	ОбластьВсегоПоля = Поле.Область(1, 1, ВысотаПоля, ШиринаПоля);
	ОбластьВсегоПоля.АвтоВысотаСтроки = Ложь;
	
	ПолеСформировано = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЗПоля()
	
	СписокРеквизитов = ЭтаФорма.ПолучитьРеквизиты();
	
	Для Каждого Строка Из СписокРеквизитов Цикл		
		Если Строка.Имя = "Значения" Тогда
			МассивУдаляемыхРеквизитов = Новый Массив;
			МассивУдаляемыхРеквизитов.Добавить("Значения");
			ИзменитьРеквизиты(, МассивУдаляемыхРеквизитов);
			Прервать;
		КонецЕсли;		
	КонецЦикла;
	
	МассивТипаВыбора = Новый Массив;
	МассивТипаВыбора.Добавить(Тип("ТаблицаЗначений"));
	
	ОписаниеТипаВыбора = Новый ОписаниеТипов(МассивТипаВыбора);
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(Новый РеквизитФормы("Значения", ОписаниеТипаВыбора, "", "Значения"));
	
	ТЗПоля = Новый ТаблицаЗначений;
	
	Для Сч = 1 По ШиринаПоля Цикл
		ТЗПоля.Колонки.Добавить("К" + Сч, Новый ОписаниеТипов("Булево"));		
	КонецЦикла;
	
	Для Сч = 1 По ВысотаПоля Цикл
		ТЗПоля.Добавить();
	КонецЦикла;
	
	Для Каждого Колонка Из ТЗПоля.Колонки Цикл		
		МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "Значения"));		
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивРеквизитов); 
	ЗначениеВРеквизитФормы(ТЗПоля, "Значения");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТочку(Строка, Колонка)
	
	ТЗПоля = РеквизитФормыВЗначение("Значения");
	ТЗПоля[Строка - 1]["К" + Колонка] = Не ТЗПоля[Строка - 1]["К" + Колонка];
	
	ЗначениеВРеквизитФормы(ТЗПоля, "Значения");
	
КонецПроцедуры

#КонецОбласти